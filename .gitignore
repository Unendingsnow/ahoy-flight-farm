seed.txt
wallet.json
keystore/

# =============================================================================
# Owner control panel — never publish. Convenience UI for owner-only calls.
# NOTE: the Vercel CLI uploads the working tree, not the git index, so
# .vercelignore blocks these too. Keep both in sync.
# =============================================================================
web/admin.html
web/assets/admin.js

# =============================================================================
# Build output / dependencies — all regenerable
# =============================================================================
node_modules
cache
artifacts
coverage
coverage.json
typechain
typechain-types

# =============================================================================
# Local deployment records. Live-network records ARE committed
# (deployments/pulsechain.json is the deployed farm — keep it).
# =============================================================================
deployments/hardhat.json
deployments/localhost.json
deployments/localPulse.json

# =============================================================================
# Local backups — the pre-cleanup archive contains a copy of .env
# =============================================================================
*-BACKUP-*.zip
*.bak

